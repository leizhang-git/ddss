<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>ddss-parent</artifactId>
        <groupId>com.ddss</groupId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ddss-provider</artifactId>

    <description>
        实现总集（provider 层，对标 iuap-data-common 的 *-provider）：
        所有 ServiceImpl、Mapper XML、*Resource REST、workflow(Flowable)、quartz、代码生成、MinIO 同步任务。
        升级 RPC 时把 web.rest 的实现改造为 RPC 服务端点，契约（ddss-consumer）不动
    </description>

    <dependencies>
        <!-- provider 自有实体/配置使用 Lombok，显式声明避免依赖传递导致注解处理不稳定 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ddss</groupId>
            <artifactId>ddss-consumer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ddss</groupId>
            <artifactId>ddss-framework</artifactId>
        </dependency>

        <!-- ZIP 压缩工具（演示造数/MinIO 下载用到） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
        </dependency>

        <!-- Flowable 工作流引擎 -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
        </dependency>

        <!-- Quartz 定时任务实现 -->
        <dependency>
            <groupId>org.quartz-scheduler</groupId>
            <artifactId>quartz</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.mchange</groupId>
                    <artifactId>c3p0</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- velocity 代码生成模板引擎 -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
        </dependency>

        <!-- 领域规则单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
