<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ddss</groupId>
        <artifactId>ddss-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>ddss-application</artifactId>
    <packaging>jar</packaging>
    <description>Framework-free application use cases and outbound ports</description>
    <dependencies>
        <dependency>
            <groupId>com.ddss</groupId>
            <artifactId>ddss-domain</artifactId>
            <version>${ddss.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-framework-free-application</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>com.baomidou:*</exclude>
                                        <exclude>org.flowable:*</exclude>
                                        <exclude>javax.servlet:*</exclude>
                                        <exclude>jakarta.servlet:*</exclude>
                                        <exclude>org.apache.kafka:*</exclude>
                                        <exclude>org.springframework.kafka:*</exclude>
                                        <exclude>org.mybatis:*</exclude>
                                    </excludes>
                                    <message>ddss-application must not depend on infrastructure frameworks.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
